# Epicyclic environment reference.
#
# This file is documentation, not runtime configuration. Flutter does not load
# .env files automatically. Pass these values with --dart-define, or put them
# in your IDE launch configuration.
#
# Demo mode is the default and needs no values. It is explicitly non-live:
# auth, orders, and notifications are stored on the device only.
APP_MODE=demo

# Set APP_MODE=supabase to use a live Supabase project. Both values are then
# required, and the app shows a blocking setup screen if either is missing.
#
# Only the public anon/publishable key belongs here. Never put a service-role
# key, database password, or payment secret in the app or this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
